{
	"description": "Single-binary installer: sets up Docker (rootless), the homerun-network, and either the Homerun Agent or the full Homerun stack on a fresh server.",
	"devDependencies": {
		"@types/bun": "^1.3.14"
	},
	"name": "homerun-install",
	"private": true,
	"scripts": {
		"build": "bun build --compile --minify --outfile dist/homerun-install ./src/index.ts",
		"build:linux-arm64": "bun build --compile --minify --target=bun-linux-arm64 --outfile dist/homerun-install-linux-arm64 ./src/index.ts",
		"build:linux-x64": "bun build --compile --minify --target=bun-linux-x64 --outfile dist/homerun-install-linux-x64 ./src/index.ts",
		"start": "bun run ./src/index.ts"
	},
	"type": "module",
	"version": "0.0.1"
}
