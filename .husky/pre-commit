#!/bin/sh
# biome
# Check if there are any staged files
echo "Registering staged files..."
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACMR)
if [ -z "$STAGED_FILES" ]; then
  echo "No staged files to format"
  exit 0
fi

bun run gen
bun run format:md
bun run lint:fix:md

echo "Formatting/linting staged files..."
# Run formatter, capturing the exit code so we can still re-stage and report
FORMAT_EXIT_CODE=0
bun run biome check --write || FORMAT_EXIT_CODE=$?

# Re-stage files that were already staged
echo "$STAGED_FILES" | while IFS= read -r file; do
  if [ -f "$file" ]; then
    echo "Staging modified changes for '$file'"
    git add -- "$file"
  fi
done

if [ $FORMAT_EXIT_CODE -ne 0 ]; then
  echo "Biome found issues that could not be auto-fixed."
  exit $FORMAT_EXIT_CODE
fi

echo "✨ Files formatted by Biome"
# biome end
