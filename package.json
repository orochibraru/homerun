{
	"dependencies": {
		"@better-auth/api-key": "^1.7.1",
		"@better-auth/oauth-provider": "1.7.1",
		"@better-auth/passkey": "^1.7.1",
		"better-auth": "^1.7.1",
		"dockerode": "^5.0.1",
		"drizzle-orm": "^0.45.2",
		"openapi-fetch": "^0.17.0",
		"reflect-metadata": "^0.2.2",
		"sanitize-html": "^2.17.7",
		"swagger-ui-dist": "^5.32.14",
		"uqr": "^0.1.3",
		"yaml": "^2.9.0"
	},
	"description": "A Cloud Run alternative for your homelab",
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@happy-dom/global-registrator": "^20.11.6",
		"@kitql/helpers": "^0.8.15",
		"@lucide/svelte": "^1.33.0",
		"@orochibraru/svelte-smol": "^1.6.1",
		"@playwright/test": "^1.62.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/bun": "^1.4.0",
		"@types/dockerode": "^4.0.1",
		"@types/node": "^26.6.1",
		"@types/sanitize-html": "^2.16.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"auth": "^1.7.1",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"conventional-changelog-conventionalcommits": "^10.0.0",
		"devalue": "^5.9.1",
		"drizzle-kit": "^0.31.10",
		"markdownlint-cli2": "^0.23.2",
		"marked": "^18.0.11",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^10.0.0",
		"only-allow": "^1.2.2",
		"openapi-typescript": "^7.13.0",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2002",
		"prettier": "^3.9.6",
		"semantic-release": "^25.0.9",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tailwint": "^1.1.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.2.2",
		"zod": "^4.4.3"
	},
	"name": "homerun",
	"overrides": {
		"conventional-changelog-writer": "^9.2.1"
	},
	"packageManager": "bun@1.4.2",
	"patchedDependencies": {
		"cpu-features@0.0.10": "patches/cpu-features@0.0.10.patch"
	},
	"private": true,
	"scripts": {
		"auth:db:generate": "auth generate",
		"build": "bun run build:app && bun run build:packages",
		"build:app": "bun run gen && vite build",
		"build:packages": "bun run scripts/build-packages.ts",
		"check": "bun run check:app && bun run check:packages",
		"check:agent": "go vet ./cmd/agent/... ./internal/agent/... ./tests/unit/go/internal/agent/...",
		"check:app": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --tsgo",
		"check:cli": "go vet ./cmd/cli/... ./internal/cli/... ./tests/unit/go/internal/cli/...",
		"check:go": "go vet ./cmd/... ./internal/... ./tests/unit/go/...",
		"check:installer": "go vet ./cmd/installer/... ./internal/installer/... ./tests/unit/go/internal/installer/...",
		"check:scripts": "tsc --noEmit --project tsconfig.scripts.json",
		"check:packages": "bun run check:go && bun run check:scripts",
		"component:add": "shadcn-svelte add",
		"db:generate": "drizzle-kit generate",
		"dev": "bun scripts/dev.ts",
		"dev:app": "vite dev",
		"dev:agent": "go run ./cmd/agent",
		"dev:worker": "bun scripts/dev.ts --only=worker",
		"e2e:multipass": "bun run scripts/e2e-multipass.ts",
		"e2e:multipass:release": "bun run scripts/e2e-multipass-release.ts",
		"format": "bun run format:md && bun run format:ts",
		"format:ts": "biome format --write",
		"format:md": "bun run prettier --log-level warn --write \"**/*.md\"",
		"gen": "svelte-kit sync && bun run scripts/generate-openapi.ts && openapi-typescript ./openapi.json -o tests/integration/support/openapi-types.ts && bunx biome check --write tests/integration/support/openapi-types.ts && bun run scripts/generate-config-schema.ts",
		"lint": "bun run lint:md && bun run lint:tailwind && bun run lint:ts",
		"lint:fix": "bun run lint:fix:md && bun run lint:fix:tailwind && bun run lint:fix:ts",
		"lint:fix:md": "markdownlint-cli2 --fix \"**/*.md\"",
		"lint:fix:tailwind": "bun run scripts/lint-tailwind.ts --fix",
		"lint:fix:ts": "oxlint --type-aware --fix",
		"lint:md": "markdownlint-cli2 \"**/*.md\"",
		"lint:tailwind": "bun run scripts/lint-tailwind.ts",
		"lint:ts": "oxlint --type-aware --deny-warnings",
		"preinstall": "bunx only-allow bun",
		"prepare": "prek install --allow-missing-config || true",
		"preview": "vite preview",
		"release": "semantic-release",
		"start": "./build/server",
		"test": "svelte-kit sync && bun test --timeout 120000 && bun run test:go",
		"screenshots": "playwright test --config playwright.screenshots.config.ts",
		"test:e2e": "playwright test",
		"test:e2e:cli": "playwright test tests/e2e/bootstrap.spec.ts tests/e2e/onboarding.spec.ts tests/e2e/ui-cli.spec.ts",
		"test:integration": "bun test tests/integration --timeout 120000",
		"test:unit": "svelte-kit sync && bun --config=bunfig.unit.toml test tests/unit --timeout 120000",
		"test:go": "go test ./cmd/... ./internal/... ./tests/unit/go/...",
		"test:unit:agent": "go test ./internal/agent/... ./tests/unit/go/internal/agent/...",
		"test:unit:app": "svelte-kit sync && bun --config=bunfig.unit.toml test tests/unit/app --timeout 120000",
		"test:unit:cli": "go test ./internal/cli/... ./tests/unit/go/internal/cli/...",
		"test:unit:installer": "go test ./internal/installer/... ./tests/unit/go/internal/installer/..."
	},
	"type": "module",
	"version": "1.0.38"
}
