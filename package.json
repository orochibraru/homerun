		"swagger-ui-dist": "^5.32.14",
		"uqr": "^0.1.3",
		"yaml": "^2.9.0"
	},
	"description": "A Cloud Run alternative for your homelab",
	"devDependencies": {
		"@biomejs/biome": "2.5.13",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/jetbrains-mono": "^5.3.0",
		"@happy-dom/global-registrator": "^20.11.6",
		"@internationalized/date": "^3.12.0",
		"@j178/prek": "^0.5.3",
		"@kitql/helpers": "^0.8.15",
		"@lucide/svelte": "^1.33.0",
		"@orochibraru/svelte-smol": "^1.6.1",
		"@playwright/test": "^1.62.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/bun": "^1.4.0",
		"@types/dockerode": "^4.0.1",
		"@types/node": "^26.6.1",
		"@types/sanitize-html": "^2.16.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"agnix": "^0.54.0",
		"auth": "^1.7.1",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"devalue": "^5.9.1",
		"dockerode": "^5.0.1",
		"drizzle-kit": "^0.31.10",
		"markdownlint-cli2": "^0.23.2",
		"marked": "^18.0.11",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^10.0.0",
		"only-allow": "^1.2.2",
		"openapi-typescript": "^7.13.0",
		"oxlint": "^1.83.0",
		"oxlint-tsgolint": "^7.0.2002",
		"prettier": "^3.9.6",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tailwint": "^1.1.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.2.2",
		"zod": "^4.4.3"
	},
	"name": "homerun",
	"packageManager": "bun@1.4.2",
	"patchedDependencies": {
		"cpu-features@0.0.10": "patches/cpu-features@0.0.10.patch"
	},
	"private": true,
	"scripts": {
		"preinstall": "bunx only-allow bun",
		"prepare": "svelte-kit sync || true && prek install --allow-missing-config || true",
		"dev": "bun scripts/dev.ts",
		"build": "bun run gen && vite build",
		"start": "./build/server",
		"gen": "svelte-kit sync && bun run scripts/generate-openapi.ts && openapi-typescript ./openapi.json -o tests/integration/support/openapi-types.ts && bunx biome check --write tests/integration/support/openapi-types.ts && bun run scripts/generate-config-schema.ts",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --tsgo && tsc --noEmit --project tsconfig.scripts.json && go vet ./cmd/... ./internal/... ./tests/unit/go/... && go tool -modfile=tools/go/go.mod golangci-lint run ./cmd/... ./internal/... ./tests/unit/go/...",
		"lint": "markdownlint-cli2 \"**/*.md\" && bun scripts/lint-tailwind.ts && oxlint --type-aware --deny-warnings",
		"lint:ai": "agnix --strict .",
		"lint:fix": "markdownlint-cli2 --fix \"**/*.md\" && bun scripts/lint-tailwind.ts --fix && oxlint --type-aware --fix",
		"format": "prettier --log-level warn --write \"**/*.md\" && biome format --write",
		"test": "svelte-kit sync && go test ./cmd/... ./internal/... ./tests/unit/go/... && bun --config=bunfig.unit.toml test tests/unit --timeout 120000",
		"test:integration": "bun test tests/integration --timeout 120000",
		"test:e2e": "playwright test",
		"screenshots": "playwright test --config playwright.screenshots.config.ts",
		"db:generate": "drizzle-kit generate"
	},
	"type": "module",
	"version": "1.0.49",
	"trustedDependencies": [
		"agnix"
	]
}
