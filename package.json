{
	"dependencies": {
		"@better-auth/api-key": "^1.7.1",
		"@better-auth/passkey": "^1.7.1",
		"better-auth": "^1.7.1",
		"dockerode": "^5.0.1",
		"drizzle-orm": "^0.45.2",
		"openapi-fetch": "^0.17.0",
		"swagger-ui-dist": "^5.32.14"
	},
	"description": "A Cloud Run alternative for your homelab",
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@fontsource-variable/inter": "^5.3.0",
		"@happy-dom/global-registrator": "^20.11.6",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@internationalized/date": "^3.12.3",
		"@kitql/helpers": "^0.8.15",
		"@lucide/svelte": "^1.33.0",
		"@saithodev/semantic-release-gitea": "^2.1.0",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/bun": "^1.4.0",
		"@types/dockerode": "^4.0.1",
		"@types/node": "^26.2.0",
		"@types/nodemailer": "^8.0.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"auth": "^1.7.1",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"commander": "^15.0.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"dprint": "^0.56.1",
		"drizzle-kit": "^0.31.10",
		"husky": "^9.1.7",
		"markdownlint": "^0.41.1",
		"markdownlint-cli2": "^0.23.2",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^9.0.5",
		"only-allow": "^1.2.2",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.6",
		"rolldown": "^1.0.0-beta.38",
		"rustywind": "^0.27.0",
		"semantic-release": "^25.0.9",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.2.2",
		"zod": "^4.4.3"
	},
	"name": "homerun",
	"private": true,
	"scripts": {
		"auth:db:generate": "auth generate",
		"build": "bun run --parallel build:app build:packages",
		"build:app": "bun run gen && vite build",
		"build:packages": "bun run scripts/build-packages.ts",
		"check": "bun run --parallel check:app check:packages",
		"check:adapter": "tsc --noEmit --project tools/adapter/tsconfig.json",
		"check:agent": "tsc --noEmit --project agent/tsconfig.json",
		"check:app": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --tsgo",
		"check:cli": "tsc --noEmit --project cli/tsconfig.json",
		"check:installer": "tsc --noEmit --project installer/tsconfig.json",
		"check:packages": " bun run --parallel check:installer check:agent check:cli check:adapter",
		"component:add": "shadcn-svelte add",
		"db:generate": "drizzle-kit generate",
		"dev": "vite dev",
		"dev:agent": "bun run --hot agent/index.ts",
		"format:md": "bun run prettier --log-level warn --write \"**/*.md\"",
		"format:md:check": "bun run prettier --log-level warn --write \"**/*.md\"",
		"gen": "svelte-kit sync && bun run scripts/generate-openapi.ts && openapi-typescript ./openapi.json -o cli/generated/openapi-types.ts",
		"lint": "bun run --parallel lint:ts lint:md",
		"lint:fix": "bun run --parallel lint:fix:ts lint:fix:md",
		"lint:fix:md": "markdownlint-cli2 --fix \"**/*.md\"",
		"lint:fix:ts": "biome check --write --unsafe",
		"lint:md": "markdownlint-cli2 \"**/*.md\"",
		"lint:ts": "biome check",
		"preinstall": "bunx only-allow bun",
		"prepare": "husky",
		"preview": "vite preview",
		"release": "semantic-release",
		"start": "bun run ./build/index.js"
	},
	"type": "module",
	"version": "0.3.3"
}
