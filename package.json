{
	"dependencies": {
		"@better-auth/api-key": "^1.7.1",
		"@better-auth/passkey": "^1.7.1",
		"better-auth": "^1.7.1",
		"dockerode": "^5.0.1",
		"drizzle-orm": "^0.45.2",
		"openapi-fetch": "^0.17.0",
		"reflect-metadata": "^0.2.2",
		"swagger-ui-dist": "^5.32.14",
		"yaml": "^2.9.0"
	},
	"description": "A Cloud Run alternative for your homelab",
	"devDependencies": {
		"@biomejs/biome": "2.5.10",
		"@fontsource-variable/inter": "^5.3.0",
		"@happy-dom/global-registrator": "^20.11.6",
		"@icons-pack/svelte-simple-icons": "^7.2.0",
		"@internationalized/date": "^3.12.3",
		"@kitql/helpers": "^0.8.15",
		"@lucide/svelte": "^1.33.0",
		"@orochibraru/svelte-smol": "^1.6.0",
		"@playwright/test": "^1.62.1",
		"@semantic-release/changelog": "^7.0.0",
		"@semantic-release/commit-analyzer": "^13.0.1",
		"@semantic-release/exec": "^7.1.0",
		"@semantic-release/git": "^11.0.1",
		"@semantic-release/github": "^12.0.9",
		"@semantic-release/release-notes-generator": "^14.1.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/language-server": "^0.16.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@testing-library/svelte": "^5.4.2",
		"@types/bun": "^1.4.0",
		"@types/dockerode": "^4.0.1",
		"@types/marked": "^6.0.0",
		"@types/node": "^26.2.0",
		"@types/nodemailer": "^8.0.1",
		"@typescript/native": "npm:typescript@^7.0.2",
		"auth": "^1.7.1",
		"bits-ui": "^2.19.0",
		"clsx": "^2.1.1",
		"commander": "^15.0.0",
		"conventional-changelog-conventionalcommits": "^9.3.1",
		"devalue": "^5.9.1",
		"dprint": "^0.57.0",
		"drizzle-kit": "^0.31.10",
		"markdownlint": "^0.41.1",
		"markdownlint-cli2": "^0.23.2",
		"marked": "^18.0.11",
		"mode-watcher": "^1.1.0",
		"nodemailer": "^9.0.5",
		"only-allow": "^1.2.2",
		"openapi-typescript": "^7.13.0",
		"prettier": "^3.9.6",
		"rolldown": "^1.0.0-beta.38",
		"rustywind": "^0.27.0",
		"semantic-release": "^25.0.9",
		"shadcn-svelte": "^1.5.0",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"svelte-sonner": "^1.2.1",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tailwint": "^1.1.15",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.2.2",
		"zod": "^4.4.3"
	},
	"name": "homerun",
	"patchedDependencies": {
		"cpu-features@0.0.10": "patches/cpu-features@0.0.10.patch"
	},
	"private": true,
	"scripts": {
		"auth:db:generate": "auth generate",
		"build": "bun run --parallel build:app build:packages",
		"build:app": "bun run gen && vite build",
		"build:docs": "bun run scripts/docs.ts build",
		"build:packages": "bun run scripts/build-packages.ts",
		"check": "bun run --parallel check:app check:packages",
		"check:agent": "tsc --noEmit --project packages/agent/tsconfig.json",
		"check:app": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings --tsgo",
		"check:cli": "tsc --noEmit --project packages/cli/tsconfig.json",
		"check:docs": "bun run scripts/docs.ts check",
		"check:installer": "tsc --noEmit --project packages/installer/tsconfig.json",
		"check:packages": " bun run --parallel check:installer check:agent check:cli check:docs",
		"component:add": "shadcn-svelte add",
		"db:generate": "drizzle-kit generate",
		"dev": "vite dev",
		"dev:agent": "bun run --hot packages/agent/index.ts",
		"dev:docs": "bun run scripts/docs.ts dev",
		"format:md": "bun run prettier --log-level warn --write \"**/*.md\"",
		"format:md:check": "bun run prettier --log-level warn --write \"**/*.md\"",
		"gen": "svelte-kit sync && bun run scripts/generate-openapi.ts && openapi-typescript ./openapi.json -o packages/cli/generated/openapi-types.ts && bunx biome check --write packages/cli/generated/openapi-types.ts && bun run scripts/generate-config-schema.ts",
		"lint": "bun run --parallel lint:ts lint:md lint:tailwind",
		"lint:fix": "bun run --parallel lint:fix:md lint:fix:tailwind && bun run lint:fix:ts",
		"lint:fix:md": "markdownlint-cli2 --fix \"**/*.md\"",
		"lint:fix:tailwind": "tailwint --fix",
		"lint:fix:ts": "biome check --write --unsafe",
		"lint:md": "markdownlint-cli2 \"**/*.md\"",
		"lint:tailwind": "tailwint",
		"lint:ts": "biome check",
		"preinstall": "bunx only-allow bun",
		"prepare": "prek install --allow-missing-config || true",
		"preview": "vite preview",
		"release": "semantic-release",
		"start": "./build/server",
		"test": "bun test --timeout 120000",
		"test:e2e": "playwright test",
		"test:integration": "bun test tests/integration --timeout 120000",
		"test:unit": "HOMERUN_SKIP_INTEGRATION_SETUP=1 bun test tests/unit --timeout 120000",
		"test:unit:agent": "HOMERUN_SKIP_INTEGRATION_SETUP=1 bun test tests/unit/agent --timeout 120000",
		"test:unit:app": "HOMERUN_SKIP_INTEGRATION_SETUP=1 bun test tests/unit/app --timeout 120000",
		"test:unit:cli": "HOMERUN_SKIP_INTEGRATION_SETUP=1 bun test tests/unit/cli --timeout 120000",
		"test:unit:installer": "HOMERUN_SKIP_INTEGRATION_SETUP=1 bun test tests/unit/installer --timeout 120000"
	},
	"type": "module",
	"version": "0.3.8"
}
