+/**
+ * A remote function call keeps the browser's own origin when it names the host
+ * the request was sent to, so a pinned ORIGIN doesn't fail SvelteKit's
+ * same-origin check for remote calls on another address of the same server.
+ * @param {Request} request
+ * @param {URL} url
+ * @returns {string | null}
+ */
+function same_host_remote_origin(request, url) {
+	const request_origin = request.headers.get('origin');
+	if (!request_origin || !url.pathname.startsWith(remote_prefix)) return null;
+	try {
+		const parsed = new URL(request_origin);
+		const host = (host_header && request.headers.get(host_header)) || request.headers.get('host');
+		return parsed.host === host ? parsed.origin : null;
+	} catch {
+		return null;
+	}
