# Loaded by Bun automatically when NODE_ENV=test (see playwright.config.ts's
# webServer.command). Exists so `bun run test:e2e` / the qa agent never runs
# against the maintainer's real dev database — this points every e2e run at
# its own disposable SQLite file instead. Safe to commit (no secrets, just a
# path) — see .gitignore's `!.env.test` exception. The DB file itself
# (e2e-test.db) is gitignored (`*.db`) and fine to delete any time to reset
# the e2e suite to a blank instance.
DB_PATH=./e2e-test.db
