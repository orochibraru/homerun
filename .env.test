# Loaded by Bun automatically when NODE_ENV=test (see playwright.config.ts's
# webServer.command). Exists so `bun run test:e2e` / the qa agent never runs
# against the maintainer's real dev database — this points every e2e run at
# its own disposable Postgres database instead, same server/credentials as
# the local `postgres` compose service, just a different database name.
# Safe to commit (no secrets, just a connection string) — see .gitignore's
# `!.env.test` exception. Create the database once with
# `createdb -h localhost -U homerun homerun_test` (or
# `docker compose exec postgres createdb -U homerun homerun_test`) — the
# e2e suite runs migrations against it itself, no seed data needed ahead of
# time, and it's safe to drop/recreate any time to reset the e2e suite to a
# blank instance.
DATABASE_URL=postgres://homerun:homerun@localhost:5432/homerun_test
