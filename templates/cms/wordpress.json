{
	"$schema": "../schema.json",
	"name": "WordPress",
	"description": "World's most-used blogging and CMS engine. Needs a linked MySQL database. Gets an MCP server from the official MCP Adapter plugin.",
	"image": "wordpress",
	"tag": "latest",
	"containerPort": 80,
	"icon": "di:wordpress",
	"tags": ["cms", "blog", "website", "php"],
	"websiteUrl": "https://wordpress.org",
	"sourceUrl": "https://github.com/WordPress/WordPress",
	"envVars": {
		"WORDPRESS_DB_HOST": "{{db}}",
		"WORDPRESS_DB_NAME": "{{db.MYSQL_DATABASE}}",
		"WORDPRESS_DB_PASSWORD": "{{db.MYSQL_ROOT_PASSWORD}}",
		"WORDPRESS_DB_USER": "root"
	},
	"links": [
		{
			"alias": "db",
			"template": "mysql"
		}
	]
}
