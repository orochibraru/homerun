{
	"$schema": "../schema.json",
	"name": "Ghost",
	"description": "Blogging platform, runs standalone with an embedded SQLite database.",
	"image": "ghost",
	"tag": "latest",
	"containerPort": 2368,
	"icon": "di:ghost",
	"tags": ["cms", "blog", "newsletter", "publishing"],
	"websiteUrl": "https://ghost.org",
	"sourceUrl": "https://github.com/TryGhost/Ghost",
	"envVars": {
		"database__client": "sqlite3",
		"database__connection__filename": "/var/lib/ghost/content/data/ghost.db",
		"database__useNullAsDefault": "true",
		"url": "{{url}}"
	},
	"volumes": ["/var/lib/ghost/content"]
}
