{
	"$schema": "../schema.json",
	"name": "HedgeDoc",
	"description": "Collaborative markdown notes. Uses a linked Postgres database.",
	"image": "quay.io/hedgedoc/hedgedoc",
	"tag": "latest",
	"containerPort": 3000,
	"icon": "di:hedgedoc",
	"tags": ["notes", "markdown", "collaboration", "writing"],
	"websiteUrl": "https://hedgedoc.org",
	"sourceUrl": "https://github.com/hedgedoc/hedgedoc",
	"envVars": {
		"CMD_DB_URL": "postgres://{{db.POSTGRES_USER}}:{{db.POSTGRES_PASSWORD}}@{{db}}:5432/{{db.POSTGRES_DB}}",
		"CMD_SESSION_SECRET": "{{secret}}"
	},
	"links": [
		{
			"alias": "db",
			"template": "postgres"
		}
	],
	"volumes": ["/hedgedoc/public/uploads"]
}
