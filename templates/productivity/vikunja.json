{
	"$schema": "../schema.json",
	"name": "Vikunja",
	"description": "Self-hosted to-do list and project management app.",
	"image": "vikunja/vikunja",
	"tag": "latest",
	"containerPort": 3456,
	"icon": "di:vikunja",
	"tags": ["tasks", "todo", "kanban", "project-management"],
	"websiteUrl": "https://vikunja.io",
	"sourceUrl": "https://github.com/go-vikunja/vikunja",
	"envVars": {
		"VIKUNJA_DATABASE_PATH": "/app/vikunja/files/vikunja.db",
		"VIKUNJA_SERVICE_JWTSECRET": "{{secret}}",
		"VIKUNJA_SERVICE_PUBLICURL": "{{url}}"
	},
	"volumes": ["/app/vikunja/files"],
	"runAsUser": "0"
}
