{
	"$schema": "../schema.json",
	"name": "Forgejo",
	"description": "Community-run Gitea fork: repositories, issues, pull requests, packages and Actions. Shows a setup wizard on first visit (SQLite works out of the box). Git over SSH on host port 2223.",
	"image": "codeberg.org/forgejo/forgejo",
	"tag": "16",
	"containerPort": 3000,
	"icon": "di:forgejo",
	"tags": ["git", "forge", "ci", "code"],
	"websiteUrl": "https://forgejo.org",
	"sourceUrl": "https://codeberg.org/forgejo/forgejo",
	"envVars": {
		"FORGEJO__server__ROOT_URL": "{{url}}",
		"FORGEJO__server__SSH_PORT": "2223"
	},
	"volumes": ["/data"],
	"publishedPorts": [
		{
			"containerPort": 22,
			"hostPort": 2223,
			"protocol": "tcp"
		}
	]
}
