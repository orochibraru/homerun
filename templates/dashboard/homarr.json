{
	"$schema": "../schema.json",
	"name": "Homarr",
	"description": "Customizable start page with app/service widgets. Has a built-in MCP server at /api/mcp, reached with a Homarr API key.",
	"image": "ghcr.io/homarr-labs/homarr",
	"tag": "latest",
	"containerPort": 7575,
	"icon": "di:homarr",
	"tags": ["dashboard", "start-page", "bookmarks", "widgets"],
	"websiteUrl": "https://homarr.dev",
	"sourceUrl": "https://github.com/homarr-labs/homarr",
	"envVars": {
		"SECRET_ENCRYPTION_KEY": "{{secret:hex64}}"
	},
	"volumes": ["/appdata"]
}
