{
	"$schema": "../schema.json",
	"name": "AIOStreams",
	"description": "Stremio super-addon that merges your other addons and debrid/usenet services into one. SECRET_KEY must be 64 hex characters (openssl rand -hex 32) and can't change after the first run. Set BASE_URL to the URL you'll reach it at.",
	"image": "ghcr.io/viren070/aiostreams",
	"tag": "latest",
	"containerPort": 3000,
	"icon": "aiostreams.svg",
	"tags": ["stremio", "addon", "debrid", "usenet", "streaming"],
	"websiteUrl": "https://docs.aiostreams.viren070.me",
	"sourceUrl": "https://github.com/Viren070/AIOStreams",
	"envVars": {
		"BASE_URL": "https://aiostreams.example.com",
		"DATABASE_URI": "postgres://{{db.POSTGRES_USER}}:{{db.POSTGRES_PASSWORD}}@{{db}}:5432/{{db.POSTGRES_DB}}",
		"SECRET_KEY": "change-me-to-64-hex-characters"
	},
	"links": [
		{
			"alias": "db",
			"template": "postgres"
		}
	]
}
