{
	"$schema": "../schema.json",
	"name": "Mattermost",
	"description": "Team chat, Slack-alike, with channels, threads, calls and integrations. Comes with a linked Postgres; the first account you create is the admin.",
	"image": "mattermost/mattermost-team-edition",
	"tag": "latest",
	"containerPort": 8065,
	"icon": "di:mattermost",
	"tags": ["chat", "team", "slack", "messaging"],
	"websiteUrl": "https://mattermost.com",
	"sourceUrl": "https://github.com/mattermost/mattermost",
	"envVars": {
		"MM_SERVICESETTINGS_SITEURL": "{{url}}",
		"MM_SQLSETTINGS_DATASOURCE": "postgres://{{db.POSTGRES_USER}}:{{db.POSTGRES_PASSWORD}}@{{db}}:5432/{{db.POSTGRES_DB}}?sslmode=disable&connect_timeout=10",
		"MM_SQLSETTINGS_DRIVERNAME": "postgres",
		"TZ": "UTC"
	},
	"volumes": [
		"/mattermost/config",
		"/mattermost/data",
		"/mattermost/logs",
		"/mattermost/plugins"
	],
	"links": [
		{
			"alias": "db",
			"template": "postgres"
		}
	]
}
