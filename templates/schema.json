{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"additionalProperties": false,
	"description": "A Homerun built-in template: templates/<category>/<slug>.json, where the folder is its category.",
	"properties": {
		"$schema": {
			"type": "string"
		},
		"capAdd": {
			"items": {
				"type": "string"
			},
			"type": "array"
		},
		"command": {
			"anyOf": [
				{
					"items": {
						"type": "string"
					},
					"type": "array"
				},
				{
					"type": "null"
				}
			]
		},
		"containerPort": {
			"maximum": 65535,
			"minimum": 1,
			"type": "integer"
		},
		"description": {
			"minLength": 1,
			"type": "string"
		},
		"devices": {
			"items": {
				"type": "string"
			},
			"type": "array"
		},
		"entrypoint": {
			"anyOf": [
				{
					"items": {
						"type": "string"
					},
					"type": "array"
				},
				{
					"type": "null"
				}
			]
		},
		"envFiles": {
			"items": {
				"type": "string"
			},
			"type": "array"
		},
		"envVars": {
			"additionalProperties": {
				"type": "string"
			},
			"description": "{{secret}} or {{secret:hex<N>}} for a generated secret, {{url}} for the service's public URL, {{alias}}/{{alias.VAR}} for a linked service.",
			"propertyNames": {
				"type": "string"
			},
			"type": "object"
		},
		"healthcheckCommand": {
			"type": "string"
		},
		"icon": {
			"description": "di:<name> for a Dashboard Icons (dashboardicons.com) icon, a file name under static/template-icons/, or an empty string for the category's generic icon.",
			"type": "string"
		},
		"image": {
			"minLength": 1,
			"type": "string"
		},
		"labels": {
			"additionalProperties": {
				"type": "string"
			},
			"propertyNames": {
				"type": "string"
			},
			"type": "object"
		},
		"links": {
			"items": {
				"additionalProperties": false,
				"properties": {
					"alias": {
						"description": "Name the env vars use to reference the linked service: {{alias}}, {{alias.VAR}}.",
						"pattern": "^[a-z0-9_-]+$",
						"type": "string"
					},
					"template": {
						"description": "File name (without .json) of the linked template, which must have no links itself.",
						"type": "string"
					}
				},
				"required": ["alias", "template"],
				"type": "object"
			},
			"type": "array"
		},
		"name": {
			"maxLength": 100,
			"minLength": 1,
			"type": "string"
		},
		"privileged": {
			"type": "boolean"
		},
		"runAsUser": {
			"description": "Docker User the container runs as: uid, uid:gid, name or name:group. Unset keeps the image's.",
			"type": "string"
		},
		"sourceUrl": {
			"anyOf": [
				{
					"format": "uri",
					"type": "string"
				},
				{
					"type": "null"
				}
			]
		},
		"tag": {
			"minLength": 1,
			"type": "string"
		},
		"tags": {
			"items": {
				"maxLength": 30,
				"minLength": 1,
				"type": "string"
			},
			"maxItems": 12,
			"minItems": 1,
			"type": "array"
		},
		"volumes": {
			"description": "Container paths that keep data: each gets its own named volume (<slug>-data, <slug>-data-1, …) when the template is deployed.",
			"items": {
				"pattern": "^\\/\\S*$",
				"type": "string"
			},
			"type": "array"
		},
		"websiteUrl": {
			"anyOf": [
				{
					"format": "uri",
					"type": "string"
				},
				{
					"type": "null"
				}
			]
		}
	},
	"required": [
		"containerPort",
		"description",
		"envVars",
		"icon",
		"image",
		"name",
		"sourceUrl",
		"tag",
		"tags",
		"websiteUrl"
	],
	"type": "object"
}
