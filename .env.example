# Homerun environment variables. Copy to `.env` and adjust.
#
# Everything else (base domain, docker, traefik, smtp, logging...) now lives
# in homerun.yaml (copy homerun.example.yaml), see docs/configuration.md.
# These stay env-only because they're needed before that file/the DB it
# backs are even reachable.

## --- Core -------------------------------------------------------------

PORT=3000

# Path to the YAML config file, defaults to ./homerun.yaml.
# CONFIG_FILE=./homerun.yaml

# Docker's own standard variable. Unset, the app uses the active `docker
# context`, then probes the usual socket paths (OrbStack, Docker Desktop,
# Colima, /var/run/docker.sock). Only unix:// sockets are honored.
# DOCKER_HOST=unix:///var/run/docker.sock

# How many jobs (deploys, builds, backups...) the Go worker runs at once.
# WORKER_CONCURRENCY=3

# The worker owns the Docker socket: the app makes no Docker calls of its own,
# it asks the worker over this HTTP API. Both sides read WORKER_TOKEN, so one
# value configures the pair. Leave it unset for local dev and the worker mints
# one and persists it to ~/.homerun-worker/token; set it explicitly whenever
# the app and the worker are separate containers, since they can't share that
# file. Nothing deploys, no status refreshes and no terminal opens while the
# worker is unreachable.
# WORKER_TOKEN=
# WORKER_URL=http://localhost:7430
# WORKER_PORT=7430

# How much the worker says about what it's doing. "debug" narrates every
# Docker Engine call with its duration, every lease and heartbeat, and every
# control-API request : that's what to turn on when a deploy misbehaves.
# Falls back to LOG_LEVEL, so one value can set both halves of the instance.
# WORKER_LOG_LEVEL=info

## --- Auth ---------------------------------------------------------------

# Secret better-auth derives session/cookie signing and every *Enc column's
# encryption key from. Generate one with `bunx auth secret` (or any 32+ byte
# random string), do NOT ship the default in production.
AUTH_SECRET=

# The scheme+host you actually open the dashboard at, port included, e.g.
# http://203.0.113.10:3000 or https://homerun.example.com. Do NOT leave it as
# localhost unless you only ever reach it from the box itself: better-auth
# trusts this origin alone, so the first sign-up from any other machine is
# rejected with "Invalid origin".
ORIGIN=http://localhost:3000

# Where custom SSL certificates and the dashboard's own Traefik route are
# written, read by Traefik's file provider. compose.yaml bind-mounts this
# directory into Traefik, so local dev gets custom SSL with no extra setup.
# The compose files that run the app in a container set it to
# /app/traefik-dynamic themselves. Unset, custom SSL does nothing.
TRAEFIK_DYNAMIC_CONFIG_DIR=./traefik-dynamic

# Where the app keeps files it caches on disk (Dashboard Icons and their
# catalog). The container image sets it to /app/data, its data volume.
# Defaults to ./data.
# STORAGE_BASE_PATH=./data

## --- Database -----------------------------------------------------------

# Must match whatever Postgres you're pointing at, the default lines up
# with compose.yaml's own postgres service defaults below, so local dev
# needs zero changes.
DATABASE_URL=postgres://homerun:homerun@localhost:5432/homerun

## --- Compose-only (read by compose.yaml, not by the app itself) ----------

# The hostname Traefik serves this dashboard at. Unset, the dashboard is
# reachable on port 3000 and at https://localhost with Traefik's own
# self-signed certificate; set it to a real hostname pointed at this server
# and Traefik requests a certificate for it. This is separate from the base
# domain your *services* are routed under, which lives in homerun.yaml.
# DASHBOARD_DOMAIN=homerun.example.com
# DASHBOARD_ENTRYPOINT=websecure
# DASHBOARD_CERT_RESOLVER=letsencrypt

ACME_EMAIL=admin@example.com
POSTGRES_DB=homerun
POSTGRES_USER=homerun
POSTGRES_PASSWORD=homerun
