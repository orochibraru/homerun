# Homerun environment variables. Copy to `.env` and adjust.
#
# Every var here is read once at boot (src/lib/config.ts) into the env
# defaults. Most of them are ALSO live-editable later from the /settings
# page (a DB-backed override, applied without a restart), see
# docs/configuration.md for exactly which ones aren't. `docker compose up
# -d` also reads a few of these directly for Traefik/Postgres, noted below.

## --- Core -------------------------------------------------------------

# Base domain deployed services get subdomained under: <slug>.<BASE_DOMAIN>
BASE_DOMAIN=localhost

# This app's own public origin, passed to better-auth for cookie/callback
# URLs. Change this if you're not running on localhost:3000.
ORIGIN=http://localhost:3000

PORT=3000

## --- Auth ---------------------------------------------------------------

# Secret better-auth derives session/cookie signing and every *Enc column's
# encryption key from. Generate one with `bunx auth secret` (or any 32+ byte
# random string), do NOT ship the default in production.
AUTH_SECRET=

# Scopes the session cookie to ".<BASE_DOMAIN>" instead of the exact host,
# so a signed-in admin is recognized across every subdomain. Off by default;
# see docs/users-and-access.md before turning this on.
AUTH_CROSS_SUBDOMAIN=false

## --- Database -----------------------------------------------------------

# Must match whatever Postgres you're pointing at, the default lines up
# with compose.yaml's own postgres service defaults below, so local dev
# needs zero changes.
DATABASE_URL=postgres://homerun:homerun@localhost:5432/homerun

## --- Docker ---------------------------------------------------------------

DOCKER_SOCKET_PATH=/var/run/docker.sock
DOCKER_NETWORK_NAME=homerun

## --- Traefik --------------------------------------------------------------

TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERT_RESOLVER=letsencrypt
# Only needed for the per-service custom SSL cert feature, see
# docs/services.md#custom-domains--ssl. Leave unset otherwise.
# TRAEFIK_DYNAMIC_CONFIG_DIR=./traefik-dynamic

# URL Traefik's forwardAuth middleware calls to check a gated service's
# login state, must be reachable *from inside the Traefik container*, not
# from the host. The default (host.docker.internal on this app's own PORT)
# works out of the box on Docker Desktop; on Linux, compose.yaml's Traefik
# service needs extra_hosts: ["host.docker.internal:host-gateway"] added.
# AUTH_CHECK_URL=http://host.docker.internal:3000/api/v1/auth-check

## --- Compose-only (read by compose.yaml, not by the app itself) ----------

# Let's Encrypt account email for the ACME cert resolver.
ACME_EMAIL=admin@example.com

POSTGRES_DB=homerun
POSTGRES_USER=homerun
POSTGRES_PASSWORD=homerun

## --- SMTP (optional, needed for admin-sent email invites) ---------------

SMTP_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=

## --- Logging --------------------------------------------------------------

LOG_LEVEL=info
LOG_FORMAT=console
