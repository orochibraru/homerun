{
	"compilerOptions": {
		"esModuleInterop": true,
		"forceConsistentCasingInFileNames": true,
		"lib": ["ESNext"],
		"module": "ESNext",
		"moduleResolution": "bundler",
		"noEmit": true,
		"resolveJsonModule": true,
		"skipLibCheck": true,
		"strict": true,
		"target": "ESNext",
		"types": ["bun-types"]
	},
	"include": [
		"client.ts",
		"commands.ts",
		"config.ts",
		"index.ts",
		"login.ts",
		"output.ts",
		"update.ts",
		"version.ts"
	]
}
