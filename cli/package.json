{
	"dependencies": {
		"openapi-fetch": "^0.14.1"
	},
	"description": "A typed CLI for Homerun's REST API, built on openapi-fetch against the spec served at /api/v1/openapi.json.",
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"openapi-typescript": "^7.13.0"
	},
	"name": "homerun-cli",
	"private": true,
	"scripts": {
		"build": "bun build --compile --minify --outfile dist/homerun ./src/index.ts",
		"build:linux-arm64": "bun build --compile --minify --target=bun-linux-arm64 --outfile dist/homerun-linux-arm64 ./src/index.ts",
		"build:linux-x64": "bun build --compile --minify --target=bun-linux-x64 --outfile dist/homerun-linux-x64 ./src/index.ts",
		"generate": "openapi-typescript $HOMERUN_BASE_URL/api/v1/openapi.json -o src/generated/openapi-types.ts",
		"start": "bun run ./src/index.ts"
	},
	"type": "module",
	"version": "0.1.0"
}
