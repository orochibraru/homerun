{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "import", "promise", "oxc"],
	"categories": {
		"correctness": "error",
		"suspicious": "error",
		"perf": "error"
	},
	"env": {
		"browser": true,
		"es2024": true,
		"node": true
	},
	"globals": {
		"Bun": "readonly"
	},
	"ignorePatterns": [
		"build/**",
		"dist/**",
		".svelte-kit/**",
		"static/template-icons/**",
		"src/lib/nuvio/nuvio-public-api.json"
	],
	"rules": {
		"complexity": ["error", 25],
		"curly": "error",
		"max-lines": [
			"error",
			{
				"max": 680,
				"skipBlankLines": true,
				"skipComments": true
			}
		],
		"max-lines-per-function": [
			"error",
			{
				"max": 105,
				"skipBlankLines": true,
				"skipComments": true
			}
		],
		"max-params": ["error", 4],
		"no-await-in-loop": "error",
		"no-console": "error",
		"no-empty": "error",
		"no-unused-vars": [
			"warn",
			{
				"ignoreRestSiblings": true,
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_"
			}
		],
		"require-await": "error",
		"typescript/consistent-type-definitions": "error",
		"typescript/no-floating-promises": "error",
		"typescript/no-misused-promises": "error",
		"import/no-unassigned-import": "off",
		"unicorn/no-array-sort": "off",
		"unicorn/no-array-reverse": "off",
		"typescript/no-unsafe-type-assertion": "off",
		"no-underscore-dangle": "off",
		"unicorn/consistent-function-scoping": "off",
		"oxc/no-map-spread": "off",
		"no-shadow": "off",
		"preserve-caught-error": "off",
		"typescript/consistent-return": "off",
		"typescript/no-base-to-string": "off",
		"typescript/restrict-template-expressions": "off",
		"promise/always-return": "off",
		"typescript/no-unnecessary-type-conversion": "off",
		"typescript/no-unnecessary-type-parameters": "off",
		"no-unmodified-loop-condition": "off",
		"typescript/no-unnecessary-type-assertion": "off"
	},
	"overrides": [
		{
			"files": ["**/*.svelte"],
			"rules": {
				"no-unused-vars": "off",
				"no-unmodified-loop-condition": "off"
			}
		},
		{
			"files": ["tests/**", "scripts/**", "**/*.config.ts", "**/*.config.js"],
			"rules": {
				"complexity": "off",
				"max-lines": "off",
				"max-lines-per-function": "off",
				"no-await-in-loop": "off",
				"no-console": "off",
				"no-empty": "off",
				"require-await": "off",
				"typescript/no-explicit-any": "off",
				"typescript/no-floating-promises": "off",
				"typescript/await-thenable": "off",
				"typescript/unbound-method": "off",
				"max-params": "off",
				"typescript/no-misused-promises": "off"
			}
		},
		{
			"files": ["src/lib/logger.ts"],
			"rules": {
				"no-console": "off"
			}
		},
		{
			"files": [
				"tests/integration/support/openapi-types.ts",
				"src/lib/server/db/schema.ts"
			],
			"rules": {
				"max-lines": "off"
			}
		},
		{
			"files": ["src/lib/services/docker/*.ts"],
			"rules": {
				"max-lines-per-function": "off"
			}
		}
	]
}
