{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
						"timeout": 20,
						"statusMessage": "Formatting"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "bun run check",
						"timeout": 90,
						"statusMessage": "Typechecking before handing back..."
					},
					{
						"type": "command",
						"command": "prek run",
						"timeout": 90,
						"statusMessage": "Running status checks..."
					},
					{
						"type": "command",
						"command": "bun run test",
						"timeout": 90,
						"statusMessage": "Running unit tests (TS + Go)..."
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"svelte@svelte": true,
		"ponytail@ponytail": true
	},
	"extraKnownMarketplaces": {
		"svelte": {
			"source": {
				"source": "github",
				"repo": "sveltejs/ai-tools"
			}
		}
	}
}
