{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "Edit|Write",
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh",
						"timeout": 20,
						"statusMessage": "Formatting"
					}
				]
			}
		],
		"Stop": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/gate.sh",
						"timeout": 600,
						"statusMessage": "Type check, prek and unit tests before handing back..."
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"svelte@svelte": true,
		"ponytail@ponytail": true
	},
	"extraKnownMarketplaces": {
		"svelte": {
			"source": {
				"source": "github",
				"repo": "sveltejs/ai-tools"
			}
		}
	}
}
