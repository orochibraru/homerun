{
	"hooks": {
		"PostToolUse": [
			{
				"hooks": [
					{
						"command": "bun run fix --skip=correctness/noUnusedImports",
						"type": "command"
					},
					{
						"command": "bun run test:unit",
						"statusMessage": "Running unit tests...",
						"timeout": 120,
						"type": "command"
					}
				],
				"matcher": "Write|Edit|MultiEdit"
			}
		]
	}
}
