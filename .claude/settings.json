{
	"hooks": {
		"PostToolUse": [
			{
				"matcher": "*",
				"hooks": [
					{
						"type": "command",
						"command": "prek run --all-files",
						"timeout": 120,
						"statusMessage": "Running prek..."
					},
					{
						"type": "command",
						"command": "bun run test:integration",
						"timeout": 120,
						"statusMessage": "Running integration tests..."
					},
					{
						"type": "command",
						"command": "bun run test:e2e",
						"timeout": 120000,
						"statusMessage": "Running e2e tests..."
					}
				]
			}
		]
	},
	"enabledPlugins": {
		"svelte@svelte": true,
		"ponytail@ponytail": true
	},
	"extraKnownMarketplaces": {
		"svelte": {
			"source": {
				"source": "github",
				"repo": "sveltejs/ai-tools"
			}
		}
	}
}
