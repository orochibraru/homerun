{
	"extraKnownMarketplaces": {
		"svelte": {
			"source": {
				"source": "github",
				"repo": "sveltejs/ai-tools"
			}
		}
	},
	"enabledPlugins": {
		"svelte@svelte": true
	},
	"hooks": {
		"PostToolUse": [
			{
				"hooks": [
					{
						"command": "bun run lint:fix",
						"statusMessage": "Running linters...",
						"type": "command"
					},
					{
						"command": "bun run test:unit",
						"statusMessage": "Running unit tests...",
						"timeout": 120,
						"type": "command"
					}
				],
				"matcher": "Write|Edit|MultiEdit"
			}
		]
	}
}
